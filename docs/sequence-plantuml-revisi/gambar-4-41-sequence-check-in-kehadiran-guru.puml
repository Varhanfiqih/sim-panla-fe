@startuml
skinparam monochrome true
skinparam shadowing false
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #666666
    LifeLineBackgroundColor white
    ParticipantBorderColor black
    ParticipantBackgroundColor white
    ActorBorderColor black
    ActorBackgroundColor white
}
autonumber

title Sequence Diagram Check-in Kehadiran Guru

actor "Guru" as Actor
boundary "Halaman Check-in" as UI
control "TeacherAttendanceController" as Controller
entity "TeacherAttendance" as Attendance
control "MobileNotificationService" as Notification

Actor -> UI: Membuka halaman check-in
UI -> Controller: Meminta status check-in hari ini
Controller -> Attendance: Memeriksa data kehadiran hari ini
Attendance --> Controller: Status check-in
Controller --> UI: Menampilkan status check-in
Actor -> UI: Memilih status hadir/tidak hadir
UI -> Controller: Mengirim konfirmasi kehadiran
Controller -> Controller: Validasi status dan alasan
alt Data valid
Controller -> Attendance: Menyimpan kehadiran guru
Controller -> Notification: Mengirim notifikasi check-in
Notification --> Controller: Notifikasi diproses
Controller --> UI: Mengirim status berhasil
UI --> Actor: Menampilkan konfirmasi berhasil
else Data tidak valid
Controller --> UI: Mengirim pesan validasi
UI --> Actor: Menampilkan pesan kesalahan
end
@enduml
