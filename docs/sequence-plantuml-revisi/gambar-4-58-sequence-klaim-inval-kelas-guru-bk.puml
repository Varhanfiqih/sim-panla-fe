@startuml
skinparam monochrome true
skinparam shadowing false
skinparam sequence {
    ArrowColor black
    LifeLineBorderColor #666666
    LifeLineBackgroundColor white
    ParticipantBorderColor black
    ParticipantBackgroundColor white
    ActorBorderColor black
    ActorBackgroundColor white
}
autonumber

title Sequence Diagram Klaim Inval Kelas Guru BK

actor "Guru BK" as Actor
boundary "Halaman Inval Guru BK" as UI
control "JournalController" as Controller
entity "Schedule" as Schedule
entity "InvalAssignment" as Inval

Actor -> UI: Membuka daftar kelas inval
UI -> Controller: Meminta inval tersedia
Controller -> Schedule: Mengambil jadwal inval
Controller -> Inval: Memeriksa status klaim
Schedule --> Controller: Data jadwal inval
Inval --> Controller: Data klaim
Controller --> UI: Menampilkan kelas inval tersedia
Actor -> UI: Memilih kelas inval
UI -> Controller: Mengirim klaim Guru BK
Controller -> Controller: Validasi role Guru BK dan konflik jadwal
alt Klaim valid
Controller -> Inval: Menyimpan klaim Guru BK
Controller --> UI: Mengirim status berhasil
UI --> Actor: Menampilkan klaim berhasil
else Klaim tidak valid
Controller --> UI: Mengirim pesan gagal
UI --> Actor: Menampilkan pesan gagal
end
@enduml
